# market-feed 설정
# 실제 값은 .env 로 복사해서 채우세요. .env 는 절대 커밋하지 마세요.
# (서버에서는 deploy/install.sh 가 자동 생성합니다)

PORT=6210
# 서버: 0.0.0.0 (외부 접속) / 로컬 개발: 127.0.0.1
HOST=127.0.0.1
MARKET_DB_FILE=./data/feed.db

# ── 인증 (반드시 서로 다른 값으로) ───────────────────
#   생성: openssl rand -hex 32
MARKET_WRITE_SECRET=
MARKET_READ_KEY=

# ── IP 허용목록 (이 서버엔 방화벽이 없어 유일한 차단 지점) ──
# 비워두면 /whoami 외 전부 차단됩니다 (fail-closed).
# 단일 IP 와 CIDR 모두 지원:  127.0.0.1,121.178.29.188,10.0.0.0/8
# 집 IP 가 바뀌면:  ./deploy/allow-ip.sh auto
MARKET_ALLOWED_IPS=127.0.0.1
